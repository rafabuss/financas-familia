# Configurações do Supabase para o Finanças da Família
# Substitua com as credenciais do seu projeto criado em https://supabase.com
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Chave da API Google Gemini (gratuita em https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=sua-chave-gemini-aqui
